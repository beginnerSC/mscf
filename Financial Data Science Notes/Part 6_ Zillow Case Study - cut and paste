Slide 25:

ggplot(trainmerged, aes(x=bedroomcnt, fill=logerrorbin)) + 
  geom_bar(position="fill") +
  labs(x = "Bedroom Count", y="Proportion", 
       fill="Log Error Bin")

ggplot(trainmerged, aes(x=roomcnt, fill=logerrorbin)) + 
  geom_bar(position="fill") +
  labs(x = "Room Count", y="Proportion", 
       fill="Log Error Bin")


